# ==========================================================================
# VersionWise AI — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg://versionwise:versionwise@localhost:5432/versionwise

# --- LLM provider (chat/generation) ---
# Supported: openai | openai_compatible | mock (dev/tests only)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional: base URL for OpenAI-compatible providers (e.g. http://localhost:11434/v1)
LLM_BASE_URL=

# --- Embedding provider ---
# Supported: openai | openai_compatible | mock (dev/tests only)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=

# --- Object storage (S3-compatible; RustFS via docker-compose in dev) ---
# Supported: s3 | local (local writes under ./.local-storage)
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=versionwise-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1

# --- App security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- API server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API with credentials
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (Next.js public env) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Retrieval defaults ---
RETRIEVAL_TOP_K=8
RETRIEVAL_SIMILARITY_THRESHOLD=0.15
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# Rate limiting (per-IP sliding window)
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=30
